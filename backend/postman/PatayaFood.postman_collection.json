{
  "info": {
    "name": "PatayaFood API",
    "description": "End-to-end tests for the MongoDB + JWT score API. There is no roster: any well-formed employee ID logs in (trimmed, uppercased, must match ^[A-Z0-9-]{1,50}$), and a player's gameData record is created by their first score save. `validPersonCode` and `victimPersonCode` default to two test IDs (`E2E-PLAYER-A` / `E2E-PLAYER-B`); change them to keep test rows apart from real players. The `token` and `victimToken` variables populate automatically from the login requests. Tests 9 (clamp) and 10 (monotonic) are order-dependent, so run the whole collection top-to-bottom.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "validPersonCode", "value": "E2E-PLAYER-A", "type": "string" },
    { "key": "victimPersonCode", "value": "E2E-PLAYER-B", "type": "string" },
    { "key": "invalidPersonCode", "value": "bad id!", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "victimToken", "value": "", "type": "string" },
    { "key": "victimBaseline", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Login (valid PersonCode) — captures token",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/person/{{validPersonCode}}", "host": ["{{baseUrl}}"], "path": ["api", "person", "{{validPersonCode}}"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('exists is a boolean (false until the first score save)', () => pm.expect(body.exists).to.be.a('boolean'));",
              "pm.test('returns token', () => pm.expect(body.token).to.be.a('string').and.not.empty);",
              "pm.test('returns person + gameData', () => {",
              "  pm.expect(body.person).to.be.an('object');",
              "  pm.expect(body.gameData).to.be.an('object');",
              "});",
              "pm.test('person.personCode is the normalized ID', () => pm.expect(body.person.personCode).to.eql(pm.collectionVariables.get('validPersonCode').trim().toUpperCase()));",
              "pm.collectionVariables.set('token', body.token);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. Login (brand-new ID) — 200, exists=false, zeros",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/person/{{freshPersonCode}}", "host": ["{{baseUrl}}"], "path": ["api", "person", "{{freshPersonCode}}"] }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Lowercase on purpose: the server must uppercase it.",
              "pm.variables.set('freshPersonCode', 'new-' + Date.now());"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('exists=false', () => pm.expect(body.exists).to.eql(false));",
              "pm.test('returns token', () => pm.expect(body.token).to.be.a('string').and.not.empty);",
              "pm.test('person.personCode is the uppercase ID', () => pm.expect(body.person.personCode).to.eql(pm.variables.get('freshPersonCode').toUpperCase()));",
              "pm.test('gameData is all zeros', () => pm.expect(body.gameData).to.eql({",
              "  fishSelectionScore: 0, fishPrepScore: 0, fishCheckTempScore: 0,",
              "  fishPackagingScore: 0, stageCount: 0, totalScore: 0",
              "}));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3. Login (invalid ID format) — expect 400",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/person/{{invalidPersonCodeEncoded}}", "host": ["{{baseUrl}}"], "path": ["api", "person", "{{invalidPersonCodeEncoded}}"] }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// \"bad id!\" -> \"bad%20id!\" so the space survives as a path segment.",
              "pm.variables.set('invalidPersonCodeEncoded', encodeURIComponent(pm.collectionVariables.get('invalidPersonCode')));"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
              "const body = pm.response.json();",
              "pm.test('success=false', () => pm.expect(body.success).to.eql(false));",
              "pm.test('no token leaked', () => pm.expect(body.token).to.be.undefined);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4. Score POST without token — expect 401",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fishSelectionScore\": 50,\n  \"fishPrepScore\": 2,\n  \"fishCheckTempScore\": 20,\n  \"fishPackagingScore\": 1,\n  \"stageCount\": 1\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/scores", "host": ["{{baseUrl}}"], "path": ["api", "scores"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "5. Score POST with bogus token — expect 401",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer not.a.real.token" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fishSelectionScore\": 50,\n  \"fishPrepScore\": 2,\n  \"fishCheckTempScore\": 20,\n  \"fishPackagingScore\": 1,\n  \"stageCount\": 1\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/scores", "host": ["{{baseUrl}}"], "path": ["api", "scores"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "6. Capture victim baseline (login as victim, capture victim token)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/person/{{victimPersonCode}}", "host": ["{{baseUrl}}"], "path": ["api", "person", "{{victimPersonCode}}"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('victimToken', body.token);",
              "pm.collectionVariables.set('victimBaseline', JSON.stringify(body.gameData));",
              "console.log('Victim baseline stored:', body.gameData);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "7. Impersonation attempt — login as A, POST with victim's personCode in body",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"personCode\": \"{{victimPersonCode}}\",\n  \"fishSelectionScore\": 999,\n  \"fishPrepScore\": 999,\n  \"fishCheckTempScore\": 999,\n  \"fishPackagingScore\": 999,\n  \"stageCount\": 11\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/scores", "host": ["{{baseUrl}}"], "path": ["api", "scores"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK (write succeeds — but for A, not victim)', () => pm.response.to.have.status(200));",
              "// The point is in test #8: confirm victim's row is UNCHANGED."
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "8. Verify victim untouched after impersonation attempt",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/person/{{victimPersonCode}}", "host": ["{{baseUrl}}"], "path": ["api", "person", "{{victimPersonCode}}"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "const baseline = JSON.parse(pm.collectionVariables.get('victimBaseline'));",
              "pm.test('victim sub-scores unchanged (server ignored body personCode)', () => {",
              "  pm.expect(body.gameData.fishSelectionScore).to.eql(baseline.fishSelectionScore);",
              "  pm.expect(body.gameData.fishPrepScore).to.eql(baseline.fishPrepScore);",
              "  pm.expect(body.gameData.fishCheckTempScore).to.eql(baseline.fishCheckTempScore);",
              "  pm.expect(body.gameData.fishPackagingScore).to.eql(baseline.fishPackagingScore);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "9. Clamp — POST INT_MAX, expect server to cap at MAX_SCORES",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fishSelectionScore\": 999999,\n  \"fishPrepScore\": 999999,\n  \"fishCheckTempScore\": 999999,\n  \"fishPackagingScore\": 999999,\n  \"stageCount\": 999\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/scores", "host": ["{{baseUrl}}"], "path": ["api", "scores"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const gd = pm.response.json().data;",
              "pm.test('fishSelectionScore clamped to 500', () => pm.expect(gd.fishSelectionScore).to.eql(500));",
              "pm.test('fishPrepScore clamped to 4',        () => pm.expect(gd.fishPrepScore).to.eql(4));",
              "pm.test('fishCheckTempScore clamped to 400', () => pm.expect(gd.fishCheckTempScore).to.eql(400));",
              "pm.test('fishPackagingScore clamped to 3',   () => pm.expect(gd.fishPackagingScore).to.eql(3));",
              "pm.test('stageCount clamped to 11',          () => pm.expect(gd.stageCount).to.eql(11));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "10. Monotonic — POST a lower score, expect stored value unchanged",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fishSelectionScore\": 1,\n  \"fishPrepScore\": 1,\n  \"fishCheckTempScore\": 1,\n  \"fishPackagingScore\": 1,\n  \"stageCount\": 0\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/scores", "host": ["{{baseUrl}}"], "path": ["api", "scores"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const gd = pm.response.json().data;",
              "// After test #9 the row should be at the clamped max (500/4/400/3, stage 11).",
              "// Posting 1s must not deflate it.",
              "pm.test('fishSelectionScore did NOT decrease', () => pm.expect(gd.fishSelectionScore).to.eql(500));",
              "pm.test('fishPrepScore did NOT decrease',      () => pm.expect(gd.fishPrepScore).to.eql(4));",
              "pm.test('fishCheckTempScore did NOT decrease', () => pm.expect(gd.fishCheckTempScore).to.eql(400));",
              "pm.test('fishPackagingScore did NOT decrease', () => pm.expect(gd.fishPackagingScore).to.eql(3));",
              "pm.test('stageCount did NOT decrease',         () => pm.expect(gd.stageCount).to.eql(11));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "11. Leaderboard (no auth required)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/scores?personCode={{validPersonCode}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "scores"],
          "query": [{ "key": "personCode", "value": "{{validPersonCode}}" }]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('returns data array (up to top 3)', () => {",
              "  pm.expect(body.data).to.be.an('array');",
              "  pm.expect(body.data.length).to.be.at.most(3);",
              "});",
              "pm.test('entries carry personCode + totalScore and no name fields', () => {",
              "  body.data.forEach((row) => {",
              "    pm.expect(row).to.have.property('personCode');",
              "    pm.expect(row).to.have.property('totalScore');",
              "    pm.expect(row).to.not.have.any.keys('fnameE', 'lnameE', 'nickName');",
              "  });",
              "});",
              "pm.test('returns caller rank row', () => pm.expect(body.player).to.be.an('object'));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
