# Copy to .env and fill in. Never commit .env.

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=food

# Required — the server won't start without it. Keep it stable: changing it
# logs everyone out. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=3000

# Optional — enables GET /api/export?key=<EXPORT_KEY>. Leave empty to disable.
EXPORT_KEY=
